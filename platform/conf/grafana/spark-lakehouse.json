{
  "title": "Spark Lakehouse",
  "uid": "spark-lakehouse",
  "tags": ["spark", "lakehouse", "metrics-stack"],
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "machine",
        "type": "query",
        "query": {
          "query": "label_values(up, machine)",
          "refId": "A"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Cores in use vs total",
      "description": "Worker-side view, summed over all Spark worker containers. Spark 4.1's master servlet exposes workers/apps gauges only (no core totals), so the total is used + free across workers. Rises while jobs run, falls back after.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(metrics_worker_coresUsed_Value{machine=~\"$machine\"})",
          "instant": false,
          "legendFormat": "in use"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(metrics_worker_coresUsed_Value{machine=~\"$machine\"}) + sum(metrics_worker_coresFree_Value{machine=~\"$machine\"})",
          "instant": false,
          "legendFormat": "total granted"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Executor memory used (GB)",
      "description": "Executors of the Spark Connect server (notebook workloads), from the driver's /metrics/executors/prometheus. Batch-job executors run in throwaway driver containers whose metrics are not published; see those in the app UI or history server.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "gbytes",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(metrics_executor_memoryUsed_bytes{machine=~\"$machine\",executor_id!=\"driver\"})/1e9",
          "instant": false,
          "legendFormat": "used"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(metrics_executor_maxMemory_bytes{machine=~\"$machine\",executor_id!=\"driver\"})/1e9",
          "instant": false,
          "legendFormat": "max"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Shuffle write (MB/min)",
      "description": "Shuffle bytes written per minute by the Spark Connect server's executors (notebook workloads). A sustained rise with rising GC share is the classic too-many-partitions / too-little-memory signal.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "mbytes",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "60 * sum(rate(metrics_executor_totalShuffleWrite_bytes_total{machine=~\"$machine\",executor_id!=\"driver\"}[5m]))/1e6",
          "instant": false,
          "legendFormat": "shuffle write"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Executor disk used (GB)",
      "description": "Block-manager disk use of the Spark Connect server's executors (shuffle and spill files on the scratch SSD). Spark 4.1's metric servlets expose no live disk-spill series; true spill per stage is in the app UI or history server.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "gbytes",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(metrics_executor_diskUsed_bytes{machine=~\"$machine\",executor_id!=\"driver\"})/1e9",
          "instant": false,
          "legendFormat": "block-manager disk"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "GC time share of task time (%)",
      "description": "Garbage-collection time as a share of total task time, Spark Connect server's executors. Sustained values above ~10% mean the heaps are too small for the workload.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 10 }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "100 * sum(rate(metrics_executor_totalGCTime_seconds_total{machine=~\"$machine\",executor_id!=\"driver\"}[5m])) / sum(rate(metrics_executor_totalDuration_seconds_total{machine=~\"$machine\",executor_id!=\"driver\"}[5m]))",
          "instant": false,
          "legendFormat": "gc share"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Scratch free space (GB)",
      "description": "Free space on /mnt/scratch (XFS SSD holding Spark shuffle and spill, SPARK_LOCAL_DIRS). The early warning for a spill-heavy job filling the disk.",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "gbytes",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 100 }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "node_filesystem_avail_bytes{machine=~\"$machine\",mountpoint=\"/mnt/scratch\"}/1e9",
          "instant": false,
          "legendFormat": "free"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "node_filesystem_size_bytes{machine=~\"$machine\",mountpoint=\"/mnt/scratch\"}/1e9",
          "instant": false,
          "legendFormat": "total"
        }
      ]
    }
  ]
}
