# NUMA-pinned shape (Phase 7): no unpinned workers; make up-numa generates one
# worker service per NUMA node (NPS4: 4 nodes), each pinned with
# `numactl --cpunodebind --membind`. 4 x 20 cores / 160g = the tutorial's
# "Spark's share of the box": about 80 of 112 threads, 640 GB.
SPARK_WORKERS=0
SPARK_WORKER_CORES=20
SPARK_WORKER_MEMORY=160g
SPARK_WORKER_MEM_LIMIT=184g
# 4 executors per worker: 5 cores, 34g heap + 6g overhead = 40g each, 160g per
# worker. (The tutorial's 40g heap + 6g overhead = 46g would fit only 3
# executors per 160g worker, leaving 5 of its 20 cores unused.)
EXECUTOR_CORES=5
EXECUTOR_MEMORY=34g
EXECUTOR_MEMORY_OVERHEAD=6g
SPARK_SHUFFLE_PARTITIONS=200
APP_MAX_CORES=80
CONNECT_MAX_CORES=16
